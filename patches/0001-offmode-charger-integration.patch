diff --git a/init/main.c b/init/main.c
index 4232747..db12f71 100644
--- a/init/main.c
+++ b/init/main.c
@@ -27,6 +27,7 @@
 #include <linux/initrd.h>
 #include <linux/bootmem.h>
 #include <linux/acpi.h>
+#include <linux/offmode_charger.h>
 #include <linux/console.h>
 #include <linux/nmi.h>
 #include <linux/percpu.h>
@@ -1103,6 +1104,14 @@ static int __ref kernel_init(void *unused)
 
 	rcu_end_inkernel_boot();
 
+	/*
+	 * Off-mode charging: when the bootloader asked for charger mode run
+	 * the charging UI right here instead of starting init.  It returns
+	 * only when the user asked for a normal boot.
+	 */
+	if (offmode_charger_init())
+		offmode_charger_start();
+
 	if (ramdisk_execute_command) {
 		ret = run_init_process(ramdisk_execute_command);
 		if (!ret)
diff --git a/techpack/display/msm/msm_fbdev.c b/techpack/display/msm/msm_fbdev.c
index 78f804c..b703e42 100644
--- a/techpack/display/msm/msm_fbdev.c
+++ b/techpack/display/msm/msm_fbdev.c
@@ -21,6 +21,10 @@
 #include <drm/drm_crtc.h>
 #include <drm/drm_fb_helper.h>
 
+#if IS_ENABLED(CONFIG_OFFMODE_CHARGER)
+#include <linux/offmode_charger.h>
+#endif
+
 #include "msm_drv.h"
 #include "msm_kms.h"
 
@@ -185,7 +189,37 @@ struct drm_fb_helper *msm_fbdev_init(struct drm_device *dev)
 		goto fail;
 	}
 
-	ret = drm_fb_helper_single_add_all_connectors(helper);
+#if IS_ENABLED(CONFIG_OFFMODE_CHARGER)
+	if (offmode_charger_requested()) {
+		struct drm_connector_list_iter conn_iter;
+		struct drm_connector *connector;
+
+		/*
+		 * Charger mode draws into the real panel: the writeback
+		 * connector is listed first on some device trees and msm
+		 * registers it as VIRTUAL, so skip it.  Normal boots keep
+		 * the stock behaviour.
+		 */
+		drm_connector_list_iter_begin(dev, &conn_iter);
+		drm_for_each_connector_iter(connector, &conn_iter) {
+			if (connector->connector_type ==
+			    DRM_MODE_CONNECTOR_WRITEBACK ||
+			    connector->connector_type ==
+			    DRM_MODE_CONNECTOR_VIRTUAL)
+				continue;
+
+			ret = drm_fb_helper_add_one_connector(helper,
+							      connector);
+			if (ret)
+				break;
+		}
+		drm_connector_list_iter_end(&conn_iter);
+	} else
+#endif
+	{
+		ret = drm_fb_helper_single_add_all_connectors(helper);
+	}
+
 	if (ret)
 		goto fini;
 
